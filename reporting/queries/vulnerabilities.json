{
  "name": "vulnerabilities",
  "index": "wazuh-states-vulnerabilities-*",
  "purpose": "Vulnerability summary: counts by severity and top CVEs per asset",
  "time_field": "timestamp",
  "query": {
    "size": 0,
    "aggs": {
      "by_severity": {
        "terms": {
          "field": "vulnerability.severity",
          "size": 10
        }
      }
    }
  },
  "range_days": 30
}