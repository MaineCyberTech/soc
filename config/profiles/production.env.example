# MCT Security Stack - PRODUCTION profile (placeholders only - no secrets)
WAZUH_ADMIN_PASSWORD=${WAZUH_ADMIN_PASSWORD}
WAZUH_WUI_PASSWORD=${WAZUH_WUI_PASSWORD}
INDEXER_PASSWORD=${INDEXER_PASSWORD}
SHUFFLE_API_KEY=${SHUFFLE_API_KEY}
SHUFFLE_ORG_ID=${SHUFFLE_ORG_ID}
DO_ACCESS_KEY=${DO_ACCESS_KEY}
DO_SECRET_KEY=${DO_SECRET_KEY}
DO_BUCKET=${DO_BUCKET}
# Kestrel GitHub App broker (replaces the production GH_PAT runtime path).
KESTREL_BROKER_URL=http://192.168.222.225:8090
KESTREL_GITHUB_APP=${KESTREL_GITHUB_APP}
KESTREL_BROKER_TOKEN_FILE=/etc/soc/kestrel-broker-token-github
# Optional cache override (default: /run/soc/kestrel-github-token-<alias>.json)
# KESTREL_GITHUB_TOKEN_CACHE=${KESTREL_GITHUB_TOKEN_CACHE}
# Rollback only until the observation window closes:
# GH_PAT=${GH_PAT}
PVE_HOST=${PVE_HOST}
PVE_TOKEN=${PVE_TOKEN}
VT_API_KEY=${VT_API_KEY}
WAZUH_VERSION=4.14.7
