{
  "name": "mct-security-stack-config-schema",
  "version": "1.0",
  "profiles": [
    "lab",
    "production",
    "client",
    "scratch"
  ],
  "rules": {
    "no_secrets_in_source": true,
    "placeholders_only": "values are ${VAR} references resolved from env files at runtime",
    "defaults_policy": "secure default; fail-closed when required var missing",
    "validation": "config/profiles/<profile>.env.example documents required vars per profile"
  },
  "profile_required_vars": {
    "lab": [
      "WAZUH_ADMIN_PASSWORD",
      "WAZUH_WUI_PASSWORD",
      "INDEXER_PASSWORD",
      "SHUFFLE_API_KEY",
      "SHUFFLE_ORG_ID",
      "WAZUH_VERSION",
      "CLUSTER_NAME"
    ],
    "production": [
      "WAZUH_ADMIN_PASSWORD",
      "WAZUH_WUI_PASSWORD",
      "INDEXER_PASSWORD",
      "SHUFFLE_API_KEY",
      "SHUFFLE_ORG_ID",
      "DO_ACCESS_KEY",
      "DO_SECRET_KEY",
      "DO_BUCKET",
      "GH_PAT",
      "PVE_HOST",
      "PVE_TOKEN",
      "VT_API_KEY",
      "WAZUH_VERSION"
    ],
    "client": [
      "CLIENT_ID",
      "CLIENT_NAME",
      "CLIENT_ENDPOINT_COUNT",
      "SCAN_SCOPE",
      "SCAN_AUTH_FILE"
    ],
    "scratch": [
      "SCRATCH_ADMIN_PASSWORD",
      "SCRATCH_REPO_LOCATION",
      "SCRATCH_PORT_HTTP",
      "SCRATCH_PORT_TRANSPORT",
      "SCRATCH_INDEX_PREFIX"
    ]
  },
  "component_fields": [
    "id",
    "purpose",
    "owner",
    "lifecycle",
    "canonical_source",
    "runtime_path",
    "version",
    "compat",
    "dependencies",
    "install_order",
    "env_profile_inputs",
    "secret_refs",
    "listeners",
    "dns_tls_firewall",
    "storage",
    "backup_restore",
    "migration",
    "installer_idempotent",
    "health_check",
    "smoke_test",
    "upgrade",
    "rollback",
    "offline_cache",
    "license",
    "docs",
    "deprecation",
    "deployability"
  ],
  "required": [
    "CLIENT_ENDPOINT_COUNT",
    "CLIENT_ID",
    "CLIENT_NAME",
    "CLUSTER_NAME",
    "DO_ACCESS_KEY",
    "DO_BUCKET",
    "DO_SECRET_KEY",
    "GH_PAT",
    "INDEXER_PASSWORD",
    "PVE_HOST",
    "PVE_TOKEN",
    "SCAN_AUTH_FILE",
    "SCAN_SCOPE",
    "SCRATCH_ADMIN_PASSWORD",
    "SCRATCH_INDEX_PREFIX",
    "SCRATCH_PORT_HTTP",
    "SCRATCH_PORT_TRANSPORT",
    "SCRATCH_REPO_LOCATION",
    "SHUFFLE_API_KEY",
    "SHUFFLE_ORG_ID",
    "VT_API_KEY",
    "WAZUH_ADMIN_PASSWORD",
    "WAZUH_VERSION",
    "WAZUH_WUI_PASSWORD"
  ]
}