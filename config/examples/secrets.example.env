# MCT Security Stack - Secrets Example (placeholders only)
# Copy values from the operator vault. NEVER commit real secrets.

# Wazuh
WAZUH_ADMIN_PASSWORD=<REDACTED_ADMIN_PW>
WAZUH_REGISTRATION_PASSWORD=<REDACTED_REG_PW>
WAZUH_WUI_PASSWORD=<REDACTED_WUI_PW>

# PVE
PVE_HOST=192.168.222.187
PVE_USERNAME=root
PVE_PASSWORD=<REDACTED_PVE_PW>
PVE222_API_TOKEN=root@pam!token=<REDACTED_TOKEN>

# DO Spaces
DO_SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=<REDACTED_KEY>
DO_SPACES_SECRET_KEY=<REDACTED_SECRET>

# Cloudflare
TUNNEL_TOKEN=<REDACTED_TUNNEL_TOKEN>

# SO
SO_SSH_USERNAME=user
SO_SSH_PASSWORD=<REDACTED_SO_PW>

# Misc
SUDO_PASSWORD=<REDACTED_SUDO_PW>
VIRUSTOTAL_API_KEY=<REDACTED_VT_KEY>
